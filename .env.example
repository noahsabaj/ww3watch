# ── Local .env for running the pipeline locally ──────────────────────────────
# (node --import tsx --env-file=.env scripts/run-pipeline.ts)
#
# In production these live in three places (see README):
#   • Pipeline   → GitHub repo Secrets (used by .github/workflows/pipeline.yml)
#   • Frontend   → build env: PUBLIC_SUPABASE_* (deploy.yml)
#   • Edge fns   → `supabase secrets set` for LLM_* (translate only — synced from
#                  GitHub by deploy-functions.yml; the pipeline uses no LLM)

# Supabase — server (secret key sb_secret_...; bypasses RLS; never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_sb_secret_key_here

# Supabase — browser (public; safe to ship in the static bundle)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# TypeSafe Jev — relevance, per-article signals, trending and story-pair
# judgments (https://docs.typesafe.ai). Required by the pipeline.
# ~$0.042 per million input tokens; output is free.
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional — Cloudflare Worker feed proxy (cloudflare/feed-proxy.js). When set, the
# pipeline fetches PROXY-FIRST (the runner's datacenter IP is WAF-blocked by most
# origins) and falls back to a direct fetch. Omit to run direct-only.
# The Worker auto-deploys via .github/workflows/deploy-worker.yml; its deploy
# secrets (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID) are GitHub repo secrets,
# not needed here. FEED_PROXY_SECRET below must match the Worker's secret.
FEED_PROXY_URL=https://feed-proxy.your-subdomain.workers.dev
FEED_PROXY_SECRET=your_long_random_secret
