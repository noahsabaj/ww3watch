{
	"name": "ww3watch",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.scripts.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"pipeline": "node --import tsx scripts/run-pipeline.ts",
		"staging:up": "node --env-file=.env --import tsx scripts/staging/up.ts",
		"staging:dev": "node --env-file=.env.staging node_modules/vite/bin/vite.js dev --port 5175 --strictPort",
		"staging:pipeline": "node --env-file=.env.staging --import tsx scripts/run-pipeline.ts",
		"staging:down": "npx --yes supabase@2 stop --no-backup"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vitest/ui": "^5.0.5",
		"dompurify": "^3.4.17",
		"jsdom": "^30.1.3",
		"sharp": "^0.35.5",
		"sirv-cli": "^3.0.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"@huggingface/transformers": "4.2.0",
		"@supabase/supabase-js": "^2.118.0",
		"fast-xml-parser": "^5.11.2",
		"rss-parser": "^3.13.0",
		"web-push": "^3.6.7"
	},
	"overrides": {
		"onnxruntime-node": "1.24.3",
		"onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
		"adm-zip": "^0.6.1",
		"sharp": "$sharp"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"onnxruntime-node": false,
		"protobufjs": false,
		"esbuild": true
	}
}
