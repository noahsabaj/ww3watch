{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	// $app/tsconfig (generated into node_modules by `svelte-kit sync`) carries
	// SvelteKit's essential and recommended options but no file list, so the one
	// svelte-check covers is declared here: what the generated config used to
	// cover. scripts/ has its own project (tsconfig.scripts.json).
	"include": ["src", "vite.config.ts"]
}
