engine-strict=true

# onnxruntime-node (via @huggingface/transformers) has a postinstall that
# downloads ~300MB of CUDA binaries on linux-x64 by default — on every npm ci,
# in every workflow. We run CPU-only; skip it. The npm 11 that ships with Node
# 24 doesn't run it at all (package.json's allowScripts denies it) and warns that
# it doesn't know these two keys; they are for npm 10 (Node 22), which ignores
# allowScripts. Both flag spellings cover the pre-1.22 and post-1.22 names.
onnxruntime-node-install-cuda=skip
onnxruntime-node-install=skip
